                                    <Canvas x:Name="PingCanvas" ClipToBounds="True"/>
                                </Border>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="@{net.ping.target}" Foreground="{StaticResource FaintBrush}" FontSize="13"/>
                                    <TextBlock Grid.Column="2" Text="Ping" Foreground="{StaticResource FaintBrush}" FontSize="13"/>
