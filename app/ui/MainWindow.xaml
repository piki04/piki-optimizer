                                    <WrapPanel>
                                        <Button x:Name="BtnRestorePoint" Style="{StaticResource Btn}" Content="@{restore.point.create}" Margin="0,0,8,8"/>
                                        <Button x:Name="BtnRstrui" Style="{StaticResource Btn}" Content="@{restore.point.open}" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="@{restore.all}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="@{restore.all.sub}" Style="{StaticResource Sub}" Margin="0,4,0,14"/>
                                    <Button x:Name="BtnUndoAll" Style="{StaticResource BtnDanger}" HorizontalAlignment="Left" Content="@{restore.all.btn}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource H2}" Text="@{restore.active}"/>
                        <ItemsControl x:Name="ActiveList" ItemTemplate="{StaticResource HistTpl}"/>
                        <TextBlock x:Name="ActiveEmpty" Style="{StaticResource Sub}" Text="@{restore.none}" Visibility="Collapsed"/>
                        <TextBlock Style="{StaticResource H2}" Text="@{restore.history}"/>
                        <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource HistTpl}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- REMOTE ASSISTANCE -->
                <ScrollViewer x:Name="PageRemote" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="28,4,28,28" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="@{remote.title}"/>
                        <TextBlock Style="{StaticResource Sub}" Text="@{remote.sub}" Margin="0,6,0,0" FontSize="14"/>
                        <UniformGrid Columns="2" Margin="0,20,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Top">
                                        <Border Width="52" Height="52" CornerRadius="16" Background="#332ED47A" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE8E1;" Style="{StaticResource IconText}" FontSize="24" Foreground="{StaticResource GoodBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="@{remote.get}" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="SemiBold" Margin="0,16,0,6"/>
                                        <TextBlock Text="@{remote.get.d}" Style="{StaticResource Sub}"/>
                                    </StackPanel>
                                    <Button x:Name="BtnRemoteGet" DockPanel.Dock="Bottom" Style="{StaticResource BtnPrimary}" Content="@{remote.get.btn}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Top">
                                        <Border Width="52" Height="52" CornerRadius="16" Background="#337C5CFF" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE7F4;" Style="{StaticResource IconText}" FontSize="24" Foreground="#B9A8FF" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="@{remote.give}" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="SemiBold" Margin="0,16,0,6"/>
                                        <TextBlock Text="@{remote.give.d}" Style="{StaticResource Sub}"/>
                                    </StackPanel>
                                    <Button x:Name="BtnRemoteGive" DockPanel.Dock="Bottom" Style="{StaticResource Btn}" Content="@{remote.give.btn}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                                </DockPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock x:Name="RemoteStatus" Text="" Foreground="{StaticResource Accent2Brush}" FontWeight="SemiBold" Margin="2,14,0,0" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Background="#26FFB547" BorderBrush="#66FFB547">
                            <DockPanel>
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="22" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Top" Margin="0,2,16,0"/>
                                <StackPanel>
                                    <TextBlock Text="@{remote.warn.title}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="@{remote.warn}" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- SETTINGS -->
                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="28,4,28,28" MaxWidth="860" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="@{set.title}"/>
                        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="@{set.lang}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="@{set.lang.sub}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <WrapPanel x:Name="LangPanel" Margin="0,46,0,0"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <Grid>
                                <StackPanel Margin="0,0,80,0">
                                    <TextBlock Text="@{set.expert}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="@{set.expert.sub}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ExpertSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="@{set.custom}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="@{set.custom.sub}" Style="{StaticResource Sub}" Margin="0,4,0,14"/>
                                <WrapPanel>
                                    <Button x:Name="BtnLogoPick" Style="{StaticResource Btn}" Content="@{set.logo.pick}" Margin="0,0,8,8"/>
                                    <Button x:Name="BtnLogoReset" Style="{StaticResource Btn}" Content="@{set.logo.reset}" Margin="0,0,8,8"/>
                                    <Button x:Name="BtnBgPick" Style="{StaticResource Btn}" Content="@{set.bg.pick}" Margin="0,0,8,8"/>
                                    <Button x:Name="BtnBgRemove" Style="{StaticResource Btn}" Content="@{set.bg.remove}" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="@{set.bg.level}" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <RadioButton x:Name="BgLevel1" Style="{StaticResource Pill}" GroupName="bglevel" Tag="1" Content="@{set.bg.1}"/>
                                    <RadioButton x:Name="BgLevel2" Style="{StaticResource Pill}" GroupName="bglevel" Tag="2" Content="@{set.bg.2}"/>
                                    <RadioButton x:Name="BgLevel3" Style="{StaticResource Pill}" GroupName="bglevel" Tag="3" Content="@{set.bg.3}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,80,0">
                                        <TextBlock Text="@{set.tray}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="@{set.tray.sub}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TraySwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,16,0,0">
                                    <StackPanel Margin="0,0,80,0">
                                        <TextBlock Text="@{set.autostart}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="@{set.autostart.sub}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoStartSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,80,0">
                                        <TextBlock Text="@{set.update}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="@{set.update.sub}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoUpdateSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="BtnCheckUpdate" Style="{StaticResource Btn}" Content="@{set.update.check}"/>
                                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="@{set.tools}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button x:Name="BtnShortcut" Style="{StaticResource Btn}" Content="@{set.shortcut}" Margin="0,0,8,8"/>
                                    <Button x:Name="BtnOpenLogs" Style="{StaticResource Btn}" Content="@{set.logs}" Margin="0,0,8,8"/>
                                    <Button x:Name="BtnPurgeRam" Style="{StaticResource Btn}" Content="@{set.purge}" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="@{set.about}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock x:Name="AboutText" Style="{StaticResource Sub}" Margin="0,6,0,0" Text="@{set.about.text}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- pending changes bar -->
            <Border x:Name="PendingBar" Grid.Row="3" Margin="28,0,28,18" CornerRadius="14" Padding="18,12" Background="#15132B" BorderBrush="#4B3DB0" BorderThickness="1" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PendingText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkRestorePoint" Style="{StaticResource Tick}" IsChecked="True" Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="@{pending.rp}" Foreground="{StaticResource SubBrush}"/>
                        </CheckBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnPendingReset" Style="{StaticResource Btn}" Content="@{pending.reset}"/>
                        <Button x:Name="BtnPendingApply" Style="{StaticResource BtnPrimary}" Content="@{pending.apply}" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- toast -->
            <Border x:Name="Toast" Grid.Row="2" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,90" CornerRadius="12" Padding="16,12" Background="#21FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" MaxWidth="420" Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="{StaticResource GoodBrush}" FontSize="15" VerticalAlignment="Top" Margin="0,1,0,0"/>
                    <TextBlock x:Name="ToastText" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="360" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================ OVERLAYS -->
        <!-- busy -->
        <Grid x:Name="BusyOverlay" Grid.ColumnSpan="2" Background="#D9080A0F" Visibility="Collapsed">
            <Border Width="460" CornerRadius="18" Background="#D9121620" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="30" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Width="54" Height="54" HorizontalAlignment="Left">
                        <Ellipse Stroke="#252A40" StrokeThickness="5"/>
                        <Ellipse x:Name="Spinner" Stroke="{StaticResource AccentGrad}" StrokeThickness="5" StrokeDashArray="7 30" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform x:Name="SpinnerRot" Angle="0"/></Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="BusyTitle" Text="" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="Bold" Margin="0,18,0,0"/>
                    <TextBlock x:Name="BusyText" Text="" Style="{StaticResource Sub}" Margin="0,6,0,14"/>
                    <Border Height="6" CornerRadius="3" Background="#24FFFFFF">
                        <Border x:Name="BusyBar" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{StaticResource AccentGrad}"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- dialog -->
        <Grid x:Name="DialogOverlay" Grid.ColumnSpan="2" Background="#CC080A0F" Visibility="Collapsed">
            <Border Width="560" CornerRadius="18" Background="#D9121620" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="28" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <TextBlock x:Name="DialogText" Style="{StaticResource Sub}" FontSize="13.5"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="DialogNo" Style="{StaticResource Btn}" Content="@{common.cancel}"/>
                        <Button x:Name="DialogYes" Style="{StaticResource BtnPrimary}" Content="OK" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- one-click wizard -->
        <Grid x:Name="WizardOverlay" Grid.ColumnSpan="2" Background="#E6080A0F" Visibility="Collapsed">
            <Border Width="860" CornerRadius="20" Background="#E6121620" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="34,30" VerticalAlignment="Center">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="@{wiz.title}" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="Bold"/>
                        <Button x:Name="WizClose" Style="{StaticResource TitleBtn}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-16,0"/>
                    </Grid>
                    <TextBlock Text="@{wiz.sub}" Style="{StaticResource Sub}" FontSize="14" Margin="0,6,0,20"/>
                    <UniformGrid Columns="5" Margin="0,0,-12,0">
                        <RadioButton x:Name="WizGaming" Style="{StaticResource ChoiceCard}" GroupName="wiz" Tag="gaming">
                            <StackPanel><TextBlock Text="&#x1F3AE;" FontFamily="Segoe UI Emoji" FontSize="28"/><TextBlock Text="@{preset.gaming}" FontWeight="Bold" FontSize="14" Margin="0,10,0,4"/><TextBlock Text="@{preset.gaming.d}" Style="{StaticResource Sub}" FontSize="13"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="WizCompetitive" Style="{StaticResource ChoiceCard}" GroupName="wiz" Tag="competitive">
                            <StackPanel><TextBlock Text="&#x1F3C6;" FontFamily="Segoe UI Emoji" FontSize="28"/><TextBlock Text="@{preset.competitive}" FontWeight="Bold" FontSize="14" Margin="0,10,0,4"/><TextBlock Text="@{preset.competitive.d}" Style="{StaticResource Sub}" FontSize="13"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="WizCreator" Style="{StaticResource ChoiceCard}" GroupName="wiz" Tag="creator">
                            <StackPanel><TextBlock Text="&#x1F3AC;" FontFamily="Segoe UI Emoji" FontSize="28"/><TextBlock Text="@{preset.creator}" FontWeight="Bold" FontSize="14" Margin="0,10,0,4"/><TextBlock Text="@{preset.creator.d}" Style="{StaticResource Sub}" FontSize="13"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="WizBalanced" Style="{StaticResource ChoiceCard}" GroupName="wiz" Tag="balanced">
                            <StackPanel><TextBlock Text="&#x2696;" FontFamily="Segoe UI Emoji" FontSize="28"/><TextBlock Text="@{preset.balanced}" FontWeight="Bold" FontSize="14" Margin="0,10,0,4"/><TextBlock Text="@{preset.balanced.d}" Style="{StaticResource Sub}" FontSize="13"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="WizLaptop" Style="{StaticResource ChoiceCard}" GroupName="wiz" Tag="laptop">
                            <StackPanel><TextBlock Text="&#x1F50B;" FontFamily="Segoe UI Emoji" FontSize="28"/><TextBlock Text="@{preset.laptop}" FontWeight="Bold" FontSize="14" Margin="0,10,0,4"/><TextBlock Text="@{preset.laptop.d}" Style="{StaticResource Sub}" FontSize="13"/></StackPanel>
                        </RadioButton>
                    </UniformGrid>
                    <Border CornerRadius="12" Background="#33000000" Padding="18,14" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="WizSummary" Text="@{wiz.pick}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                            <TextBlock x:Name="WizDetail" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" Foreground="{StaticResource GoodBrush}"/>
                            <TextBlock Text="@{wiz.safe}" Foreground="{StaticResource SubBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="WizGo" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right" Padding="26,12" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" Foreground="White"/>
                                <TextBlock Text="@{wiz.go}" Foreground="White" FontWeight="Bold" FontSize="14" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- splash / first scan -->
        <Grid x:Name="SplashOverlay" Grid.ColumnSpan="2" Background="#0A0C11">
            <Button x:Name="SplashClose" Style="{StaticResource CloseBtn}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="5"/>
            <Ellipse Width="900" Height="700" Opacity="0.25" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7C5CFF" Offset="0"/>
                        <GradientStop Color="#0022D3EE" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
                <Grid Width="96" Height="96" HorizontalAlignment="Center">
                    <Border CornerRadius="26" Background="{StaticResource AccentGrad}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="50" ShadowDepth="0" Color="#7C5CFF" Opacity="0.8"/>
                        </Border.Effect>
                        <TextBlock Text="P" FontFamily="{StaticResource Display}" FontWeight="Black" FontSize="58" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,4"/>
                    </Border>
                    <Border x:Name="SplashLogoCustom" CornerRadius="26" Visibility="Collapsed"/>
                </Grid>
                <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource Display}" FontSize="34" FontWeight="Bold" Margin="0,24,0,0"><Run Text="Piki "/><Run Text="Optimizer" Foreground="#22D3EE"/></TextBlock>
                <TextBlock x:Name="SplashTitle" Text="@{splash.title}" HorizontalAlignment="Center" Foreground="{StaticResource SubBrush}" FontSize="15" Margin="0,6,0,30" TextAlignment="Center" TextWrapping="Wrap"/>
                <Border Height="6" CornerRadius="3" Background="#24FFFFFF">
                    <Border x:Name="SplashBar" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{StaticResource AccentGrad}"/>
                </Border>
                <TextBlock x:Name="SplashStep" Text="" HorizontalAlignment="Center" Foreground="{StaticResource FaintBrush}" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
