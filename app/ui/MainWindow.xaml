                            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14"><StackPanel><TextBlock x:Name="StatSvcs" Text="-" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="Bold"/><TextBlock Text="@{proc.stat.svcs}" Foreground="{StaticResource SubBrush}" FontSize="13"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14"><StackPanel><TextBlock x:Name="StatStartup" Text="-" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="Bold"/><TextBlock Text="@{proc.stat.startup}" Foreground="{StaticResource SubBrush}" FontSize="13"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14"><StackPanel><TextBlock x:Name="StatRam" Text="-" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="Bold"/><TextBlock Text="@{proc.stat.ram}" Foreground="{StaticResource SubBrush}" FontSize="13"/></StackPanel></Border>
