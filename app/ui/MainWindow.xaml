                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="@{net.ping.title}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="@{net.ping.sub}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
