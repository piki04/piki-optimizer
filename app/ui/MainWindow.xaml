                            <RadioButton x:Name="PresetLaptop" Style="{StaticResource ChoiceCard}" GroupName="preset" Tag="laptop">
                                <StackPanel><TextBlock Text="&#x1F50B;" FontFamily="Segoe UI Emoji" FontSize="24"/><TextBlock Text="@{preset.laptop}" FontWeight="Bold" FontSize="14" Margin="0,10,0,4"/><TextBlock Text="@{preset.laptop.d}" Style="{StaticResource Sub}" FontSize="13"/></StackPanel>
