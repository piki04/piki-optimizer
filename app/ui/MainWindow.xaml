<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piki Optimizer" Width="1240" Height="820" MinWidth="1060" MinHeight="690"
        WindowStartupLocation="CenterScreen" Background="#0A0C11" Foreground="#ECEFF6"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>

        <SolidColorBrush x:Key="BgBrush" Color="#0A0C11"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#66101420"/>
        <!-- liquid glass: frosted fill brighter at the top, rim light on the top-left and bottom-right edges -->
        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0.6,1">
            <GradientStop Color="#3DFFFFFF" Offset="0"/>
            <GradientStop Color="#1FFFFFFF" Offset="0.45"/>
            <GradientStop Color="#14FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassBtnBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40FFFFFF" Offset="0"/>
            <GradientStop Color="#1FFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassBtnHover" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#59FFFFFF" Offset="0"/>
            <GradientStop Color="#2EFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#33FFFFFF"/>
        <LinearGradientBrush x:Key="LineBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B3FFFFFF" Offset="0"/>
            <GradientStop Color="#33FFFFFF" Offset="0.3"/>
            <GradientStop Color="#12FFFFFF" Offset="0.62"/>
            <GradientStop Color="#59FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TextBrush" Color="#F6F8FC"/>
        <SolidColorBrush x:Key="SubBrush" Color="#BCC3D3"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#929BB0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF"/>
        <SolidColorBrush x:Key="Accent2Brush" Color="#22D3EE"/>
        <SolidColorBrush x:Key="GoodBrush" Color="#2ED47A"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#FFB547"/>
        <SolidColorBrush x:Key="BadBrush" Color="#FF5D73"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#5AA9FF"/>
        <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7C5CFF" Offset="0"/>
            <GradientStop Color="#22D3EE" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B1640" Offset="0"/>
            <GradientStop Color="#101826" Offset="0.55"/>
            <GradientStop Color="#0E1F2A" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,26,0,10"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.30" Color="#000000"/></Setter.Value></Setter>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource GlassBtnBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassBtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow" CornerRadius="16" Background="{StaticResource AccentGrad}" Opacity="0.4" Margin="-2">
                                <Border.Effect>
                                    <BlurEffect Radius="14"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Bd" Background="{StaticResource AccentGrad}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="14" BorderThickness="1" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#99FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="#FFA3B0"/>
            <Setter Property="Background" Value="#33FF5D73"/>
            <Setter Property="BorderBrush" Value="#66FF5D73"/>
        </Style>
        <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar navigation -->
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="10" Background="Transparent" Padding="14,10">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,10" Background="{StaticResource AccentGrad}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2BFFFFFF"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill tabs / segmented choices -->
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="18" Background="{StaticResource GlassBtnBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#59FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentGrad}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset / choice cards -->
        <Style x:Key="ChoiceCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="20" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.2" Padding="16,16">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#59FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGrad}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#337C5CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="13" Background="#33FFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1"/>
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="#9AA3B8" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGrad}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tick" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" Background="#21FFFFFF" BorderBrush="#59FFFFFF" BorderThickness="1.5">
                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentGrad}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim scrollbars -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="#40FFFFFF" Margin="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" Orientation="Horizontal">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border CornerRadius="4" Background="#40FFFFFF" Margin="2"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#21FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3DFFFFFF"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <!-- Risk chip -->
        <Style x:Key="RiskChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#1E2A5AA9"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Risk}" Value="safe"><Setter Property="Background" Value="#1E2ED47A"/></DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="caution"><Setter Property="Background" Value="#22FFB547"/></DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="advanced"><Setter Property="Background" Value="#26FF8A4C"/></DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="avoid"><Setter Property="Background" Value="#26FF5D73"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RiskText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Risk}" Value="safe"><Setter Property="Foreground" Value="{StaticResource GoodBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="caution"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="advanced"><Setter Property="Foreground" Value="#FF9A5C"/></DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="avoid"><Setter Property="Foreground" Value="{StaticResource BadBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#1E5AA9FF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="good"><Setter Property="Background" Value="#1E2ED47A"/></DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="protect"><Setter Property="Background" Value="#2A7C5CFF"/></DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="bad"><Setter Property="Background" Value="#26FF5D73"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="good"><Setter Property="Foreground" Value="{StaticResource GoodBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="protect"><Setter Property="Foreground" Value="#B9A8FF"/></DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="bad"><Setter Property="Foreground" Value="{StaticResource BadBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SevIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="warn"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="crit"><Setter Property="Foreground" Value="{StaticResource BadBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="info"><Setter Property="Foreground" Value="{StaticResource InfoBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SevDisc" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Background" Value="#1A2ED47A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="warn"><Setter Property="Background" Value="#1FFFB547"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="crit"><Setter Property="Background" Value="#24FF5D73"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="info"><Setter Property="Background" Value="#1F5AA9FF"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18,15"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="OptCard" TargetType="Border" BasedOn="{StaticResource RowCard}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter Property="BorderBrush" Value="#7C5CFF"/>
                    <Setter Property="Background" Value="#2E7C5CFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============================ templates -->
        <DataTemplate x:Key="OptionTpl">
            <Border Style="{StaticResource OptCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,2"/>
                            <Border Style="{StaticResource RiskChip}"><TextBlock Text="{Binding RiskLabel}" Style="{StaticResource RiskText}"/></Border>
                            <Border Style="{StaticResource BadgeChip}" Visibility="{Binding HasBadge, Converter={StaticResource B2V}}"><TextBlock Text="{Binding Badge}" Style="{StaticResource BadgeText}"/></Border>
                            <Border CornerRadius="6" Padding="7,2" Margin="8,0,0,0" Background="#1E2ED47A" VerticalAlignment="Center" Visibility="{Binding IsApplied, Converter={StaticResource B2V}}">
                                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GoodBrush}"/>
                            </Border>
                            <Border CornerRadius="6" Padding="7,2" Margin="8,0,0,0" Background="#1F5AA9FF" VerticalAlignment="Center" Visibility="{Binding NeedsReboot, Converter={StaticResource B2V}}">
                                <TextBlock Text="{Binding RebootLabel}" FontSize="12" Foreground="{StaticResource InfoBrush}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" Margin="0,5,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasWarning, Converter={StaticResource B2V}}">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource WarnBrush}" FontSize="12" Margin="0,2,7,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Warning}" Foreground="#E8C38A" TextWrapping="Wrap" MaxWidth="760" FontSize="12.5"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Extra}" Foreground="{StaticResource FaintBrush}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="{Binding HasExtra, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSelectable}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StartupTpl">
            <Border Style="{StaticResource RowCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource RiskChip}"><TextBlock Text="{Binding RiskLabel}" Style="{StaticResource RiskText}"/></Border>
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource FaintBrush}" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding Extra}" Foreground="{StaticResource FaintBrush}" FontSize="12.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" Visibility="{Binding HasExtra, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSelectable}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CleanTpl">
            <Border Style="{StaticResource RowCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource Tick}" VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1">
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                            <Border Style="{StaticResource RiskChip}"><TextBlock Text="{Binding RiskLabel}" Style="{StaticResource RiskText}"/></Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Extra}" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FindingTpl">
            <Border Style="{StaticResource RowCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SevDisc}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource SevIcon}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource GoodBrush}" Margin="0,4,0,0" FontSize="13"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource BtnSmall}" VerticalAlignment="Center" Content="{Binding ActionLabel}" Tag="{Binding ActionId}" Visibility="{Binding HasAction, Converter={StaticResource B2V}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HwTpl">
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#29FFFFFF">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="#A996FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource SubBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Sub}" Foreground="{StaticResource SubBrush}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource FaintBrush}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProcTpl">
            <Border Style="{StaticResource RowCard}" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="2.6*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource FaintBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding MemText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding CpuText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" Foreground="{StaticResource SubBrush}"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource RiskChip}" Margin="0,0,8,0"><TextBlock Text="{Binding RiskLabel}" Style="{StaticResource RiskText}"/></Border>
                        <TextBlock Text="{Binding Advice}" Foreground="{StaticResource SubBrush}" FontSize="13" TextWrapping="Wrap" MaxWidth="330" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="4" Style="{StaticResource BtnSmall}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Tag="{Binding Name}" IsEnabled="{Binding CanEnd}" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="Chiudi / Close"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PingTpl">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Avg}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding Jitter}" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding Loss}" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center"/>
                <Border Grid.Column="5" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Background="#1E5AA9FF" x:Name="QBd">
                    <TextBlock Text="{Binding Quality}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" x:Name="QTx"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding QualityKind}" Value="ok">
                    <Setter TargetName="QBd" Property="Background" Value="#1E2ED47A"/>
                    <Setter TargetName="QTx" Property="Foreground" Value="#2ED47A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding QualityKind}" Value="warn">
                    <Setter TargetName="QBd" Property="Background" Value="#22FFB547"/>
                    <Setter TargetName="QTx" Property="Foreground" Value="#FFB547"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding QualityKind}" Value="crit">
                    <Setter TargetName="QBd" Property="Background" Value="#26FF5D73"/>
                    <Setter TargetName="QTx" Property="Foreground" Value="#FF5D73"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Quality}" Value="">
                    <Setter TargetName="QBd" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="DnsTpl">
            <Border CornerRadius="10" Padding="14,10" Margin="0,0,0,6" Background="#14FFFFFF" x:Name="Bd" BorderThickness="1" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Provider}" FontWeight="SemiBold"/>
                        <TextBlock Foreground="{StaticResource FaintBrush}" FontSize="12.5"><Run Text="{Binding Primary, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Secondary, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Ms}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBest}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#2ED47A"/>
                    <Setter TargetName="Bd" Property="Background" Value="#112219"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="KvTpl">
            <Border CornerRadius="10" Padding="14,11" Margin="0,0,0,6" Background="#14FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Key}" Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Hint}" Foreground="{StaticResource FaintBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasHint, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HistTpl">
            <Border Style="{StaticResource RowCard}" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SubBrush}" FontSize="13"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource BtnSmall}" Content="@{common.undo}" Tag="{Binding Id}" Visibility="{Binding CanUndo, Converter={StaticResource B2V}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GroupHeaderTpl">
            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="15" FontWeight="SemiBold" Foreground="#B9C0D3" Margin="2,18,0,10"/>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- custom background -->
        <Image x:Name="BgImage" Grid.ColumnSpan="2" Stretch="UniformToFill" Opacity="0.35" Visibility="Collapsed" IsHitTestVisible="False" Margin="-60"><Image.Effect><BlurEffect Radius="28" KernelType="Gaussian"/></Image.Effect></Image>
        <!-- colourful blurred blobs behind the glass -->
        <Grid x:Name="Blobs" Grid.ColumnSpan="2" IsHitTestVisible="False" Opacity="0.85" ClipToBounds="True">
            <Grid.Effect><BlurEffect Radius="110" KernelType="Gaussian"/></Grid.Effect>
            <Ellipse Width="620" Height="520" Fill="#7C5CFF" Opacity="0.55" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-180,-120,0"/>
            <Ellipse Width="520" Height="440" Fill="#22D3EE" Opacity="0.35" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="120,0,0,-160"/>
            <Ellipse Width="420" Height="380" Fill="#FF4FA3" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="260,40,0,0"/>
        </Grid>

        <!-- ============================ SIDEBAR -->
        <Border x:Name="Sidebar" Background="{StaticResource PanelBrush}" BorderBrush="#26FFFFFF" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="22,22,0,0" VerticalAlignment="Top">
                    <Grid Width="36" Height="36">
                        <Border x:Name="LogoDefault" CornerRadius="10" Background="{StaticResource AccentGrad}">
                            <TextBlock Text="P" FontFamily="{StaticResource Display}" FontWeight="Black" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,1"/>
                        </Border>
                        <Border x:Name="LogoCustom" CornerRadius="10" Visibility="Collapsed" BorderBrush="#33FFFFFF" BorderThickness="1"/>
                    </Grid>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource Display}" FontSize="18" FontWeight="Bold"><Run Text="Piki "/><Run Text="Optimizer" Foreground="#22D3EE"/></TextBlock>
                        <TextBlock x:Name="VersionText" Text="v1.0.0" Foreground="{StaticResource FaintBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="14,10,14,0">
                    <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" Tag="Home" IsChecked="True">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource IconText}" FontSize="16" Width="26"/><TextBlock Text="@{nav.home}" FontSize="14" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHealth" Style="{StaticResource Nav}" Tag="Health">
                        <Grid>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE95E;" Style="{StaticResource IconText}" FontSize="16" Width="26"/><TextBlock Text="@{nav.health}" FontSize="14" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                            <Border x:Name="HealthBadge" HorizontalAlignment="Right" CornerRadius="9" MinWidth="20" Height="18" Background="#FF5D73" Padding="5,0" Visibility="Collapsed">
                                <TextBlock x:Name="HealthBadgeText" Text="0" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavOptimize" Style="{StaticResource Nav}" Tag="Optimize">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Style="{StaticResource IconText}" FontSize="16" Width="26"/><TextBlock Text="@{nav.optimize}" FontSize="14" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavProcesses" Style="{StaticResource Nav}" Tag="Processes">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" FontSize="16" Width="26"/><TextBlock Text="@{nav.processes}" FontSize="14" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavNetwork" Style="{StaticResource Nav}" Tag="Network">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" Style="{StaticResource IconText}" FontSize="16" Width="26"/><TextBlock Text="@{nav.network}" FontSize="14" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavRemote" Style="{StaticResource Nav}" Tag="Remote">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource IconText}" FontSize="16" Width="26"/><TextBlock Text="@{nav.remote}" FontSize="14" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAe" Style="{StaticResource Nav}" Tag="Ae">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" CornerRadius="5" Background="#00005B" BorderBrush="#9999FF" BorderThickness="1.2" Margin="0,0,6,0">
                                <TextBlock Text="Ae" FontSize="10" FontWeight="Bold" Foreground="#9999FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="After Effects" FontSize="14" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavCleanup" Style="{StaticResource Nav}" Tag="Cleanup">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="16" Width="26"/><TextBlock Text="@{nav.cleanup}" FontSize="14" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavRestore" Style="{StaticResource Nav}" Tag="Restore">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource IconText}" FontSize="16" Width="26"/><TextBlock Text="@{nav.restore}" FontSize="14" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="Settings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource IconText}" FontSize="16" Width="26"/><TextBlock Text="@{nav.settings}" FontSize="14" Margin="6,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- live mini monitor -->
                <Border Grid.Row="2" Margin="14,0,14,16" CornerRadius="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CPU" Foreground="{StaticResource SubBrush}" FontSize="12.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SideCpuText" Text="0%" HorizontalAlignment="Right" FontSize="12.5" FontWeight="SemiBold"/>
                        </Grid>
                        <Border Height="5" CornerRadius="3" Background="#24FFFFFF" Margin="0,5,0,10">
                            <Border x:Name="SideCpuBar" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="#22D3EE"/>
                        </Border>
                        <Grid>
                            <TextBlock Text="RAM" Foreground="{StaticResource SubBrush}" FontSize="12.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SideRamText" Text="0%" HorizontalAlignment="Right" FontSize="12.5" FontWeight="SemiBold"/>
                        </Grid>
                        <Border Height="5" CornerRadius="3" Background="#24FFFFFF" Margin="0,5,0,0">
                            <Border x:Name="SideRamBar" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="#7C5CFF"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================ CONTENT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid Background="Transparent">
                <TextBlock x:Name="TitlePc" Text="" Foreground="{StaticResource FaintBrush}" FontSize="13" VerticalAlignment="Center" Margin="28,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnMin" Style="{StaticResource TitleBtn}" Content="&#xE921;"/>
                    <Button x:Name="BtnMax" Style="{StaticResource TitleBtn}" Content="&#xE922;"/>
                    <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" Content="&#xE8BB;"/>
                </StackPanel>
            </Grid>

            <!-- update banner -->
            <Border x:Name="UpdateBanner" Grid.Row="1" Margin="28,0,28,8" CornerRadius="12" Padding="16,10" Visibility="Collapsed" Background="#17163A" BorderBrush="#4B3DB0" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" Foreground="#A996FF" FontSize="15"/>
                        <TextBlock x:Name="UpdateBannerText" Text="" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button x:Name="BtnBannerUpdate" HorizontalAlignment="Right" Style="{StaticResource BtnPrimary}" Padding="16,6" Content="@{update.now}"/>
                </Grid>
            </Border>

            <!-- ============================ PAGES -->
            <Grid Grid.Row="2" x:Name="Pages">

                <!-- HOME -->
                <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,4,28,28">
                        <TextBlock x:Name="HomeHello" Style="{StaticResource H1}" Text="@{home.title}"/>
                        <TextBlock x:Name="HomeSub" Style="{StaticResource Sub}" FontSize="14" Margin="0,4,0,0" Text="@{home.sub}"/>
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.55*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="18" Background="{StaticResource HeroGrad}" BorderBrush="#2A2550" BorderThickness="1" Padding="26,22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid Width="118" Height="118">
                                            <Ellipse Stroke="#252A40" StrokeThickness="11"/>
                                            <Ellipse x:Name="RingHealth" Visibility="Hidden" StrokeThickness="11" Stroke="#2ED47A" RenderTransformOrigin="0.5,0.5" StrokeDashCap="Round" StrokeDashArray="0 100">
                                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                                            </Ellipse>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="RingHealthText" Text="--" FontFamily="{StaticResource Display}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="@{home.health}" HorizontalAlignment="Center" Foreground="{StaticResource SubBrush}" Margin="0,8,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                        <Grid Width="118" Height="118">
                                            <Ellipse Stroke="#252A40" StrokeThickness="11"/>
                                            <Ellipse x:Name="RingPerf" Visibility="Hidden" StrokeThickness="11" Stroke="{StaticResource AccentGrad}" RenderTransformOrigin="0.5,0.5" StrokeDashCap="Round" StrokeDashArray="0 100">
                                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                                            </Ellipse>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="RingPerfText" Text="--" FontFamily="{StaticResource Display}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="@{home.perf}" HorizontalAlignment="Center" Foreground="{StaticResource SubBrush}" Margin="0,8,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="28,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="HomeStatus" Text="" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="HomeStatusSub" Text="" Style="{StaticResource Sub}" Margin="0,6,0,16"/>
                                        <Button x:Name="BtnOneClick" Style="{StaticResource BtnPrimary}" Padding="22,13" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" Foreground="White" FontSize="15"/>
                                                <TextBlock Text="@{home.oneclick}" Foreground="White" FontSize="15" FontWeight="Bold" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="BtnHomeCheck" Style="{StaticResource BtnSmall}" Content="@{home.runcheck}"/>
                                            <Button x:Name="BtnHomeBoost" Style="{StaticResource BtnSmall}" Content="@{home.boost}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="@{home.live}" FontWeight="SemiBold" Foreground="{StaticResource SubBrush}"/>
                                    <Canvas x:Name="LiveCanvas" Grid.Row="1" Margin="0,12,0,8" MinHeight="110" ClipToBounds="True">
                                        <Polyline x:Name="LiveCpuLine" Stroke="#22D3EE" StrokeThickness="2" StrokeLineJoin="Round"/>
                                        <Polyline x:Name="LiveRamLine" Stroke="#7C5CFF" StrokeThickness="2" StrokeLineJoin="Round"/>
                                    </Canvas>
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#22D3EE"/>
                                            <TextBlock Text="CPU" Foreground="{StaticResource SubBrush}" Margin="6,0,6,0" FontSize="13"/>
                                            <TextBlock x:Name="LiveCpuText" Text="0%" FontWeight="SemiBold" FontSize="13"/>
                                            <Ellipse Width="8" Height="8" Fill="#7C5CFF" Margin="18,0,0,0"/>
                                            <TextBlock Text="RAM" Foreground="{StaticResource SubBrush}" Margin="6,0,6,0" FontSize="13"/>
                                            <TextBlock x:Name="LiveRamText" Text="0%" FontWeight="SemiBold" FontSize="13"/>
                                        </StackPanel>
                                        <TextBlock x:Name="LiveProcText" HorizontalAlignment="Right" Foreground="{StaticResource FaintBrush}" FontSize="13"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock Style="{StaticResource H2}" Text="@{home.hardware}"/>
                        <ItemsControl x:Name="HwList" ItemTemplate="{StaticResource HwTpl}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

