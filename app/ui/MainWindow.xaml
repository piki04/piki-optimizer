                                    <Button x:Name="BtnBgPick" Style="{StaticResource Btn}" Content="@{set.bg.pick}" Margin="0,0,8,8"/>
                                    <Button x:Name="BtnBgRemove" Style="{StaticResource Btn}" Content="@{set.bg.remove}" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="@{set.bg.level}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <RadioButton x:Name="BgLevel1" Style="{StaticResource Pill}" GroupName="bglevel" Tag="1" Content="@{set.bg.1}"/>
                                    <RadioButton x:Name="BgLevel2" Style="{StaticResource Pill}" GroupName="bglevel" Tag="2" Content="@{set.bg.2}"/>
                                    <RadioButton x:Name="BgLevel3" Style="{StaticResource Pill}" GroupName="bglevel" Tag="3" Content="@{set.bg.3}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="@{set.tools}" FontWeight="SemiBold" FontSize="14.5" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button x:Name="BtnShortcut" Style="{StaticResource Btn}" Content="@{set.shortcut}" Margin="0,0,8,8"/>
                                    <Button x:Name="BtnRescan" Style="{StaticResource Btn}" Content="@{set.rescan}" Margin="0,0,8,8"/>
                                    <Button x:Name="BtnOpenLogs" Style="{StaticResource Btn}" Content="@{set.logs}" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="@{set.about}" FontWeight="SemiBold" FontSize="14.5"/>
                                <TextBlock x:Name="AboutText" Style="{StaticResource Sub}" Margin="0,6,0,0" Text="@{set.about.text}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- pending changes bar (no shadow effect: solid raised surface) -->
            <Border x:Name="PendingBar" Grid.Row="3" Margin="32,0,32,16" Visibility="Collapsed" CornerRadius="16" Background="#F215100E" BorderBrush="#80D9BC8C" BorderThickness="1" Padding="18,11">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PendingText" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkRestorePoint" Style="{StaticResource Tick}" IsChecked="True" Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="@{pending.rp}" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                        </CheckBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnPendingPreview" Style="{StaticResource Btn}" Content="@{opt.preview.short}"/>
                        <Button x:Name="BtnPendingReset" Style="{StaticResource Btn}" Content="@{pending.reset}" Margin="8,0,0,0"/>
                        <Button x:Name="BtnPendingApply" Style="{StaticResource BtnPrimary}" Content="@{pending.apply}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="Toast" Grid.Row="2" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,86" MaxWidth="440" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="14" Background="#F215100E" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <StackPanel Orientation="Horizontal" Margin="14,11,18,11">
                    <TextBlock x:Name="ToastIcon" Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="{StaticResource OkBrush}" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0"/>
                    <TextBlock x:Name="ToastText" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="360" FontWeight="SemiBold" LineHeight="20"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================ OVERLAYS: centred card on a 60 % black scrim, no blur -->
        <Grid x:Name="BusyOverlay" Grid.ColumnSpan="2" Background="#99000000" Visibility="Collapsed">
            <Border Width="460" VerticalAlignment="Center" CornerRadius="20" Background="#FA0C0908" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1" Padding="30">
                <StackPanel>
                    <Grid Width="40" Height="40" HorizontalAlignment="Left">
                        <Ellipse Stroke="#1AEFE9E0" StrokeThickness="3"/>
                        <Ellipse x:Name="Spinner" Stroke="{StaticResource GoldBrush}" StrokeThickness="3" StrokeDashArray="6 30" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform x:Name="SpinnerRot" Angle="0"/></Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="BusyTitle" Text="" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock x:Name="BusyText" Text="" Style="{StaticResource Sub}" Margin="0,6,0,14"/>
                    <Border Height="4" CornerRadius="2" Background="#1AEFE9E0">
                        <Border x:Name="BusyBar" HorizontalAlignment="Stretch" CornerRadius="2" Background="{StaticResource GoldBrush}" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform></Border>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="DialogOverlay" Grid.ColumnSpan="2" Background="#99000000" Visibility="Collapsed">
            <Border Width="560" VerticalAlignment="Center" CornerRadius="20" Background="#FA0C0908" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1" Padding="28">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <TextBlock x:Name="DialogText" Style="{StaticResource Sub}" Foreground="{StaticResource Text2Brush}"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="DialogNo" Style="{StaticResource Btn}" Content="@{common.cancel}"/>
                        <Button x:Name="DialogYes" Style="{StaticResource BtnPrimary}" Content="OK" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- "Velocizza il PC": profile picker -->
        <Grid x:Name="WizardOverlay" Grid.ColumnSpan="2" Background="#99000000" Visibility="Collapsed">
            <Border Width="900" VerticalAlignment="Center" CornerRadius="22" Background="#FA0C0908" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1" Padding="32,28">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="@{wiz.title2}" FontSize="24" FontWeight="SemiBold"/>
                        <Button x:Name="WizClose" Style="{StaticResource TitleBtn}" AutomationProperties.Name="@{a11y.close}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,-14,0"/>
                    </Grid>
                    <TextBlock Text="@{wiz.sub}" Style="{StaticResource Sub}" Margin="0,6,0,18"/>
                    <UniformGrid Columns="4" Margin="0,0,-10,0">
                        <RadioButton x:Name="WizSlowpc" Style="{StaticResource ChoiceCard}" GroupName="wiz" Tag="slowpc">
                            <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEC4A;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource GoldBrush}"/><Border x:Name="WizSlowBadge" CornerRadius="999" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center" Background="{StaticResource GoldBrush}" Visibility="Collapsed"><TextBlock Text="@{preset.foryou}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/></Border></StackPanel><TextBlock Text="@{preset.slowpc}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBlock Text="@{preset.slowpc.d}" Style="{StaticResource Sub}" FontSize="12.5"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="WizPiki" Style="{StaticResource ChoiceCard}" GroupName="wiz" Tag="piki">
                            <StackPanel><TextBlock Text="&#xE734;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Left"/><TextBlock Text="@{preset.piki}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBlock Text="@{preset.piki.d}" Style="{StaticResource Sub}" FontSize="12.5"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="WizGaming" Style="{StaticResource ChoiceCard}" GroupName="wiz" Tag="gaming">
                            <StackPanel><TextBlock Text="&#xE7FC;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Left"/><TextBlock Text="@{preset.gaming}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBlock Text="@{preset.gaming.d}" Style="{StaticResource Sub}" FontSize="12.5"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="WizCompetitive" Style="{StaticResource ChoiceCard}" GroupName="wiz" Tag="competitive">
                            <StackPanel><TextBlock Text="&#xE945;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Left"/><TextBlock Text="@{preset.competitive}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBlock Text="@{preset.competitive.d}" Style="{StaticResource Sub}" FontSize="12.5"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="WizCreator" Style="{StaticResource ChoiceCard}" GroupName="wiz" Tag="creator">
                            <StackPanel><TextBlock Text="&#xE714;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Left"/><TextBlock Text="@{preset.creator}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBlock Text="@{preset.creator.d}" Style="{StaticResource Sub}" FontSize="12.5"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="WizBalanced" Style="{StaticResource ChoiceCard}" GroupName="wiz" Tag="balanced">
                            <StackPanel><TextBlock Text="&#xE80F;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Left"/><TextBlock Text="@{preset.balanced}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBlock Text="@{preset.balanced.d}" Style="{StaticResource Sub}" FontSize="12.5"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="WizLaptop" Style="{StaticResource ChoiceCard}" GroupName="wiz" Tag="laptop">
                            <StackPanel><TextBlock Text="&#xE83F;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Left"/><TextBlock Text="@{preset.laptop}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBlock Text="@{preset.laptop.d}" Style="{StaticResource Sub}" FontSize="12.5"/></StackPanel>
                        </RadioButton>
                    </UniformGrid>
                    <Border Style="{StaticResource Note}" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock x:Name="WizSummary" Text="@{wiz.pick}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"/>
                            <TextBlock x:Name="WizDetail" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,330,0">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" Foreground="{StaticResource GoldBrush}"/>
                            <TextBlock Text="@{wiz.safe}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="WizPreview" Style="{StaticResource Btn}" Content="@{opt.preview.short}" IsEnabled="False"/>
                            <Button x:Name="WizGo" Style="{StaticResource BtnPrimary}" Padding="24,11" Margin="8,0,0,0" IsEnabled="False" Content="@{wiz.go}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- splash: plays once (fade), no endless loops -->
        <Grid x:Name="SplashOverlay" Grid.ColumnSpan="2" Background="#000000">
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.6" RadiusY="0.45">
                        <GradientStop Color="#427A2E33" Offset="0"/>
                        <GradientStop Color="#007A2E33" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Button x:Name="SplashClose" Style="{StaticResource CloseBtn}" AutomationProperties.Name="@{a11y.close}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="5"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
                <Grid Width="84" Height="84" HorizontalAlignment="Center">
                    <Ellipse Stroke="{StaticResource SilverBrush}" StrokeThickness="2.5"/>
                    <Ellipse Margin="9" Fill="#15100E"/>
                    <TextBlock Text="P" FontWeight="Bold" FontSize="36" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,3"/>
                    <Border x:Name="SplashLogoCustom" CornerRadius="42" Visibility="Collapsed"/>
                </Grid>
                <TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="SemiBold" Margin="0,22,0,0"><Run Text="Piki "/><Run Text="Optimizer" Foreground="#D9BC8C"/></TextBlock>
                <TextBlock x:Name="SplashTitle" Text="@{splash.title}" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,6,0,28" TextAlignment="Center" TextWrapping="Wrap"/>
                <Border Height="3" CornerRadius="2" Background="#1AEFE9E0">
                    <Border x:Name="SplashBar" HorizontalAlignment="Stretch" CornerRadius="2" Background="{StaticResource GoldBrush}" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform></Border>
                </Border>
                <TextBlock x:Name="SplashStep" Text="" HorizontalAlignment="Center" Foreground="{StaticResource FaintBrush}" Margin="0,14,0,0" FontSize="12.5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
