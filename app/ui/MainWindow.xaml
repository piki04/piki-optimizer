                                            <TextBlock Margin="0,4,0,0"><Run Text="@{net.load.loaded}" Foreground="#8E96AB"/><Run x:Name="LoadLoaded" Text=" -" FontWeight="SemiBold"/></TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="LoadVerdict" Style="{StaticResource Sub}" Margin="0,12,0,12"/>
