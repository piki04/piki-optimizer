<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piki Optimizer" Width="1180" Height="760" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#000000" Foreground="#EFE9E0"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Piki Optimizer 2.0. Tokens = the Piki site (black, cream, gold, wine). No runtime blur or shadow effects:
         depth comes from static gradients and 1 px highlights. Only opacity and transforms are animated. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <SolidColorBrush x:Key="BgBrush" Color="#000000"/>
        <SolidColorBrush x:Key="Bg2Brush" Color="#0C0908"/>
        <SolidColorBrush x:Key="RaisedBrush" Color="#15100E"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#08EFE9E0"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#0EEFE9E0"/>
        <SolidColorBrush x:Key="LineBrush" Color="#14EFE9E0"/>
        <SolidColorBrush x:Key="Line2Brush" Color="#2EEFE9E0"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EFE9E0"/>
        <SolidColorBrush x:Key="Text2Brush" Color="#D6CDC0"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A89F92"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#7D7569"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#D9BC8C"/>
        <SolidColorBrush x:Key="InkBrush" Color="#15100E"/>
        <SolidColorBrush x:Key="OkBrush" Color="#9CC69B"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#D9A55C"/>
        <SolidColorBrush x:Key="CritBrush" Color="#D0606A"/>
        <SolidColorBrush x:Key="GoldTint" Color="#1AD9BC8C"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#0DEFE9E0"/>
        <!-- glass edge: lighter on top, like the site's inner highlight -->
        <LinearGradientBrush x:Key="EdgeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2EEFE9E0" Offset="0"/>
            <GradientStop Color="#12EFE9E0" Offset="0.4"/>
            <GradientStop Color="#0DEFE9E0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="EdgeHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4DEFE9E0" Offset="0"/>
            <GradientStop Color="#24EFE9E0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SilverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7F2EA" Offset="0"/>
            <GradientStop Color="#DDD4C6" Offset="0.45"/>
            <GradientStop Color="#AEA495" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SilverHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFBF5" Offset="0"/>
            <GradientStop Color="#E9E1D4" Offset="0.45"/>
            <GradientStop Color="#BDB3A4" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2E7A2E33" Offset="0"/>
            <GradientStop Color="#0AEFE9E0" Offset="0.55"/>
            <GradientStop Color="#05EFE9E0" Offset="1"/>
        </LinearGradientBrush>

        <Duration x:Key="DurFast">0:0:0.15</Duration>
        <Duration x:Key="DurBase">0:0:0.30</Duration>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,28,0,12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <!-- optional lines: take no space when empty (cards had a blank band at the bottom) -->
        <Style x:Key="SubAuto" TargetType="TextBlock" BasedOn="{StaticResource Sub}">
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HideEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource EdgeHoverBrush}"/>
                    <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OptCard" TargetType="Border" BasedOn="{StaticResource RowCard}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                    <Setter Property="Background" Value="{StaticResource GoldTint}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Note" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Background" Value="#0AD9BC8C"/>
            <Setter Property="BorderBrush" Value="#33D9BC8C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- buttons: hover light fades in (150 ms), press squeezes a little -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                            <Border CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                            <Border x:Name="Hl" CornerRadius="12" Background="{StaticResource HoverBrush}" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurFast}" EasingFunction="{StaticResource EaseOut}"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurFast}" EasingFunction="{StaticResource EaseOut}"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- primary: the site's silver button, dark ink text -->
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                            <Border CornerRadius="12" Background="{StaticResource SilverBrush}"/>
                            <Border x:Name="Hl" CornerRadius="12" Background="{StaticResource SilverHover}" Opacity="0" IsHitTestVisible="False"/>
                            <Border CornerRadius="12" BorderBrush="#66FFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{StaticResource InkBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurFast}" EasingFunction="{StaticResource EaseOut}"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurFast}" EasingFunction="{StaticResource EaseOut}"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="#EAB0B5"/>
            <Setter Property="Background" Value="#2E7A2E33"/>
            <Setter Property="BorderBrush" Value="#807A2E33"/>
        </Style>
        <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hl" Background="#14EFE9E0" Opacity="0"/>
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="1"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hl" Background="#B37A2E33" Opacity="0"/>
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="1"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- sidebar entry: the gold-edged pill is drawn by NavIndicator (it glides), here only text colour -->
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Hl" CornerRadius="12" Background="{StaticResource HoverBrush}" Opacity="0"/>
                            <ContentPresenter Margin="14,0,10,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="16" Padding="14,7" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" TextElement.FontSize="13" TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Line2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldTint}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChoiceCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="16" Padding="16,14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EdgeHoverBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldTint}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- switch: gold track when on, the knob glides 150 ms -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="24" Background="Transparent">
                            <Border CornerRadius="12" Background="#1FEFE9E0" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"/>
                            <Border x:Name="On" CornerRadius="12" Background="{StaticResource GoldBrush}" Opacity="0"/>
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" Margin="3,0,0,0" Background="#A89F92">
                                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Knob" Property="Background" Value="#15100E"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="{StaticResource DurFast}" EasingFunction="{StaticResource EaseOut}"/>
                                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurFast}"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="{StaticResource DurFast}" EasingFunction="{StaticResource EaseOut}"/>
                                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurFast}"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tick" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Border CornerRadius="5" Background="#14EFE9E0" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"/>
                                <Border x:Name="Fill" CornerRadius="5" Background="{StaticResource GoldBrush}" Opacity="0"/>
                                <Path x:Name="Mark" Data="M4.2,9.4 L7.6,12.6 L13.8,5.6" Stroke="#15100E" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurFast}"/>
                                    <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurFast}"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurFast}"/>
                                    <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurFast}"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="#26EFE9E0" Margin="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#15100E"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <!-- chips -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="RiskChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="#0AEFE9E0"/>
            <Setter Property="BorderBrush" Value="#26EFE9E0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Risk}" Value="safe"><Setter Property="Background" Value="#149CC69B"/><Setter Property="BorderBrush" Value="#409CC69B"/></DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="caution"><Setter Property="Background" Value="#14D9A55C"/><Setter Property="BorderBrush" Value="#40D9A55C"/></DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="advanced"><Setter Property="Background" Value="#14D98C5C"/><Setter Property="BorderBrush" Value="#40D98C5C"/></DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="avoid"><Setter Property="Background" Value="#14D0606A"/><Setter Property="BorderBrush" Value="#40D0606A"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RiskText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Risk}" Value="safe"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="caution"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="advanced"><Setter Property="Foreground" Value="#D98C5C"/></DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="avoid"><Setter Property="Foreground" Value="{StaticResource CritBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <!-- badge text can wrap to 2 lines: a full pill radius turned it into an ellipse -->
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Margin" Value="8,2,0,2"/>
            <Setter Property="Background" Value="#0AEFE9E0"/>
            <Setter Property="BorderBrush" Value="#26EFE9E0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="good"><Setter Property="Background" Value="#149CC69B"/><Setter Property="BorderBrush" Value="#409CC69B"/></DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="protect"><Setter Property="Background" Value="{StaticResource GoldTint}"/><Setter Property="BorderBrush" Value="#59D9BC8C"/></DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="bad"><Setter Property="Background" Value="#14D0606A"/><Setter Property="BorderBrush" Value="#40D0606A"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="good"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="protect"><Setter Property="Foreground" Value="{StaticResource GoldBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="bad"><Setter Property="Foreground" Value="{StaticResource CritBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SevIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="warn"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="crit"><Setter Property="Foreground" Value="{StaticResource CritBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="info"><Setter Property="Foreground" Value="{StaticResource GoldBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SevDisc" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="#149CC69B"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="warn"><Setter Property="Background" Value="#14D9A55C"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="crit"><Setter Property="Background" Value="#1AD0606A"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="info"><Setter Property="Background" Value="{StaticResource GoldTint}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Text" Value="@{opt.state.off}"/>
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Text" Value="@{opt.state.on}"/>
                    <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Kind}" Value="svc"/>
                        <Condition Binding="{Binding IsChecked}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Text" Value="@{svc.state.on}"/>
                    <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Kind}" Value="svc"/>
                        <Condition Binding="{Binding IsChecked}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Text" Value="@{svc.state.off}"/>
                    <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StartupStateText" TargetType="TextBlock" BasedOn="{StaticResource StateText}">
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Text" Value="@{startup.off}"/>
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Text" Value="@{startup.on}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============================ item templates -->
        <DataTemplate x:Key="OptionTpl">
            <Border Style="{StaticResource OptCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,2"/>
                            <Border Style="{StaticResource RiskChip}"><TextBlock Text="{Binding RiskLabel}" Style="{StaticResource RiskText}"/></Border>
                            <Border Style="{StaticResource BadgeChip}" Visibility="{Binding HasBadge, Converter={StaticResource B2V}}"><TextBlock Text="{Binding Badge}" Style="{StaticResource BadgeText}" MaxWidth="520"/></Border>
                            <Border Style="{StaticResource Chip}" Background="{StaticResource GoldTint}" BorderBrush="#59D9BC8C" Visibility="{Binding IsApplied, Converter={StaticResource B2V}}">
                                <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}"/>
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="#0AEFE9E0" BorderBrush="#26EFE9E0" Visibility="{Binding NeedsReboot, Converter={StaticResource B2V}}">
                                <TextBlock Text="{Binding RebootLabel}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasWarning, Converter={StaticResource B2V}}">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource WarnBrush}" FontSize="12" Margin="0,3,7,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Warning}" Foreground="#E3C79A" TextWrapping="Wrap" MaxWidth="720" FontSize="13" LineHeight="19"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Extra}" Foreground="{StaticResource FaintBrush}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="{Binding HasExtra, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource StateText}"/>
                        <CheckBox Style="{StaticResource Switch}" VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSelectable}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StartupTpl">
            <Border Style="{StaticResource RowCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border x:Name="Imp" Style="{StaticResource Chip}" Background="#0AEFE9E0" BorderBrush="#26EFE9E0">
                                <TextBlock x:Name="ImpT" Text="{Binding Badge}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            </Border>
                            <Border Style="{StaticResource RiskChip}"><TextBlock Text="{Binding RiskLabel}" Style="{StaticResource RiskText}"/></Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Extra}" Foreground="{StaticResource FaintBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" Visibility="{Binding HasExtra, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource StartupStateText}"/>
                        <CheckBox Style="{StaticResource Switch}" VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSelectable}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="high"><Setter TargetName="Imp" Property="Background" Value="#1AD0606A"/><Setter TargetName="Imp" Property="BorderBrush" Value="#4DD0606A"/><Setter TargetName="ImpT" Property="Foreground" Value="#D0606A"/></DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="medium"><Setter TargetName="Imp" Property="Background" Value="#14D9A55C"/><Setter TargetName="Imp" Property="BorderBrush" Value="#40D9A55C"/><Setter TargetName="ImpT" Property="Foreground" Value="#D9A55C"/></DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="low"><Setter TargetName="Imp" Property="Background" Value="#149CC69B"/><Setter TargetName="Imp" Property="BorderBrush" Value="#409CC69B"/><Setter TargetName="ImpT" Property="Foreground" Value="#9CC69B"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CleanTpl">
            <Border Style="{StaticResource RowCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource Tick}" VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1">
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                            <Border Style="{StaticResource RiskChip}"><TextBlock Text="{Binding RiskLabel}" Style="{StaticResource RiskText}"/></Border>
                            <Border Style="{StaticResource BadgeChip}" Visibility="{Binding HasBadge, Converter={StaticResource B2V}}"><TextBlock Text="{Binding Badge}" Style="{StaticResource BadgeText}"/></Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Extra}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" Typography.NumeralAlignment="Tabular"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FindingTpl">
            <Border Style="{StaticResource RowCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SevDisc}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource SevIcon}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SubAuto}" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource HideEmpty}" Foreground="{StaticResource OkBrush}" Margin="0,4,0,0" FontSize="12.5"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource BtnSmall}" VerticalAlignment="Center" Content="{Binding ActionLabel}" Tag="{Binding ActionId}" Visibility="{Binding HasAction, Converter={StaticResource B2V}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- compact hardware strip: one line per component -->
        <DataTemplate x:Key="HwTpl">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="2,10" Margin="0,0,24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Sub}" Foreground="{StaticResource FaintBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProcTpl">
            <Border Style="{StaticResource RowCard}" Padding="14,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="2.6*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource FaintBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding MemText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Grid.Column="2" Text="{Binding CpuText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" Foreground="{StaticResource MutedBrush}" Typography.NumeralAlignment="Tabular"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource RiskChip}" Margin="0,0,8,0"><TextBlock Text="{Binding RiskLabel}" Style="{StaticResource RiskText}"/></Border>
                        <TextBlock Text="{Binding Advice}" Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="320" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="4" Style="{StaticResource BtnSmall}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" AutomationProperties.Name="@{proc.kill.yes}" Tag="{Binding Name}" IsEnabled="{Binding CanEnd}" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="@{proc.kill.yes}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PingTpl">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Avg}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding Jitter}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding Loss}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <Border Grid.Column="5" CornerRadius="999" Padding="9,3" HorizontalAlignment="Left" Background="#0AEFE9E0" x:Name="QBd">
                    <TextBlock Text="{Binding Quality}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" x:Name="QTx"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding QualityKind}" Value="ok"><Setter TargetName="QBd" Property="Background" Value="#149CC69B"/><Setter TargetName="QTx" Property="Foreground" Value="#9CC69B"/></DataTrigger>
                <DataTrigger Binding="{Binding QualityKind}" Value="warn"><Setter TargetName="QBd" Property="Background" Value="#14D9A55C"/><Setter TargetName="QTx" Property="Foreground" Value="#D9A55C"/></DataTrigger>
                <DataTrigger Binding="{Binding QualityKind}" Value="crit"><Setter TargetName="QBd" Property="Background" Value="#1AD0606A"/><Setter TargetName="QTx" Property="Foreground" Value="#D0606A"/></DataTrigger>
                <DataTrigger Binding="{Binding Quality}" Value="{x:Null}"><Setter TargetName="QBd" Property="Visibility" Value="Collapsed"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="DnsTpl">
            <Border CornerRadius="12" Padding="14,10" Margin="0,0,0,6" Background="{StaticResource SurfaceBrush}" x:Name="Bd" BorderThickness="1" BorderBrush="{StaticResource LineBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Provider}" FontWeight="SemiBold"/>
                        <TextBlock Foreground="{StaticResource FaintBrush}" FontSize="12"><Run Text="{Binding Primary, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Secondary, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Ms}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBest}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#D9BC8C"/>
                    <Setter TargetName="Bd" Property="Background" Value="#1AD9BC8C"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="KvTpl">
            <Border CornerRadius="12" Padding="14,10" Margin="0,0,0,6" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Key}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Hint}" Foreground="{StaticResource FaintBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasHint, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HistTpl">
            <Border Style="{StaticResource RowCard}" Padding="14,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" FontSize="12.5"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12.5"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource BtnSmall}" Content="@{common.undo}" Tag="{Binding Id}" Visibility="{Binding CanUndo, Converter={StaticResource B2V}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Misura: one measured number, before and after -->
        <DataTemplate x:Key="MetricTpl">
            <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="12.5"/>
                    <TextBlock Margin="0,6,0,0"><Run Text="{Binding Value, Mode=OneWay}" FontSize="26" FontWeight="SemiBold"/><Run Text="{Binding Unit, Mode=OneWay}" FontSize="13" Foreground="#A89F92"/></TextBlock>
                    <TextBlock Text="{Binding Before}" Foreground="{StaticResource FaintBrush}" FontSize="12" Margin="0,4,0,0"/>
                    <TextBlock x:Name="Dl" Text="{Binding Delta}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="good"><Setter TargetName="Dl" Property="Foreground" Value="#9CC69B"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="bad"><Setter TargetName="Dl" Property="Foreground" Value="#D0606A"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Home hero: four numbers -->
        <DataTemplate x:Key="StatTpl">
            <StackPanel Margin="0,0,28,0">
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="12.5"/>
                <TextBlock Margin="0,4,0,0"><Run Text="{Binding Value, Mode=OneWay}" FontSize="26" FontWeight="SemiBold"/><Run Text="{Binding Unit, Mode=OneWay}" FontSize="13" Foreground="#A89F92"/></TextBlock>
                <TextBlock Text="{Binding Sub}" Foreground="{StaticResource FaintBrush}" FontSize="12"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GroupHeaderTpl">
            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" Margin="2,18,0,10"/>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Background="#000000">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- static wine light behind everything (like the site body): no blur, nothing animated -->
        <Grid x:Name="Glow" Grid.ColumnSpan="2" IsHitTestVisible="False">
            <Border>
                <Border.Background>
                    <RadialGradientBrush Center="0.55,0" GradientOrigin="0.55,0" RadiusX="0.6" RadiusY="0.4">
                        <GradientStop Color="#427A2E33" Offset="0"/>
                        <GradientStop Color="#007A2E33" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <RadialGradientBrush Center="1,0.62" GradientOrigin="1,0.62" RadiusX="0.42" RadiusY="0.32">
                        <GradientStop Color="#1F7A2E33" Offset="0"/>
                        <GradientStop Color="#007A2E33" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <RadialGradientBrush Center="0,0.96" GradientOrigin="0,0.96" RadiusX="0.42" RadiusY="0.32">
                        <GradientStop Color="#1A7A2E33" Offset="0"/>
                        <GradientStop Color="#007A2E33" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
        <Image x:Name="BgImage" Grid.ColumnSpan="2" Stretch="UniformToFill" Opacity="0.25" Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- ============================ SIDEBAR -->
        <Border x:Name="Sidebar" Background="#B30C0908" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid x:Name="SideGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- the selected-section pill: one element that glides between entries -->
                <Canvas Grid.RowSpan="4" IsHitTestVisible="False" Margin="12,0,12,0">
                    <Border x:Name="NavIndicator" Width="208" Height="40" Opacity="0" CornerRadius="12" Background="{StaticResource GoldTint}" BorderBrush="#40D9BC8C" BorderThickness="1">
                        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                        <Border Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Margin="5,0,0,0" Background="{StaticResource GoldBrush}"/>
                    </Border>
                </Canvas>
                <StackPanel Orientation="Horizontal" Margin="20,22,0,0" VerticalAlignment="Top">
                    <Grid Width="36" Height="36">
                        <Grid x:Name="LogoDefault">
                            <Ellipse Stroke="{StaticResource SilverBrush}" StrokeThickness="2"/>
                            <Ellipse Margin="5" Fill="#15100E"/>
                            <TextBlock Text="P" FontWeight="Bold" FontSize="17" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,1"/>
                        </Grid>
                        <Border x:Name="LogoCustom" CornerRadius="18" Visibility="Collapsed" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"/>
                    </Grid>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold"><Run Text="Piki "/><Run Text="Optimizer" Foreground="#D9BC8C"/></TextBlock>
                        <TextBlock x:Name="VersionText" Text="v2.0.0" Foreground="{StaticResource FaintBrush}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="NavStack" Grid.Row="1" Margin="12,8,12,0">
                    <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" Tag="Home" IsChecked="True">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource IconText}" FontSize="15" Width="26"/><TextBlock Text="@{nav.home}" FontSize="13.5" Margin="4,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavMeasure" Style="{StaticResource Nav}" Tag="Measure">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" Style="{StaticResource IconText}" FontSize="15" Width="26"/><TextBlock Text="@{nav.measure}" FontSize="13.5" Margin="4,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavOptimize" Style="{StaticResource Nav}" Tag="Optimize">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Style="{StaticResource IconText}" FontSize="15" Width="26"/><TextBlock Text="@{nav.optimize}" FontSize="13.5" Margin="4,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavProcesses" Style="{StaticResource Nav}" Tag="Processes">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B5;" Style="{StaticResource IconText}" FontSize="15" Width="26"/><TextBlock Text="@{nav.processes}" FontSize="13.5" Margin="4,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavCleanup" Style="{StaticResource Nav}" Tag="Cleanup">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="15" Width="26"/><TextBlock Text="@{nav.cleanup}" FontSize="13.5" Margin="4,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavNetwork" Style="{StaticResource Nav}" Tag="Network">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" Style="{StaticResource IconText}" FontSize="15" Width="26"/><TextBlock Text="@{nav.network}" FontSize="13.5" Margin="4,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAe" Style="{StaticResource Nav}" Tag="Ae">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18" Height="18" CornerRadius="5" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.2" Margin="1,0,7,0">
                                <TextBlock Text="Ae" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="After Effects" FontSize="13.5" Margin="4,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHealth" Style="{StaticResource Nav}" Tag="Health">
                        <Grid Width="180">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE95E;" Style="{StaticResource IconText}" FontSize="15" Width="26"/><TextBlock Text="@{nav.health}" FontSize="13.5" Margin="4,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                            <Border x:Name="HealthBadge" HorizontalAlignment="Right" CornerRadius="9" MinWidth="20" Height="18" Background="#7A2E33" BorderBrush="#D0606A" BorderThickness="1" Padding="5,0" Visibility="Collapsed">
                                <TextBlock x:Name="HealthBadgeText" Text="0" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="12,0,12,10">
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="8,0,8,10"/>
                    <RadioButton x:Name="NavRestore" Style="{StaticResource Nav}" Tag="Restore">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource IconText}" FontSize="15" Width="26"/><TextBlock Text="@{nav.restore}" FontSize="13.5" Margin="4,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="Settings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource IconText}" FontSize="15" Width="26"/><TextBlock Text="@{nav.settings}" FontSize="13.5" Margin="4,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- mini CPU / RAM meter: updates only while the window is visible and focused -->
                <Border Grid.Row="3" Margin="14,0,14,16" CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" Padding="14,11">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CPU" Foreground="{StaticResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SideCpuText" Text="0%" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                        <Border Height="4" CornerRadius="2" Background="#1AEFE9E0" Margin="0,5,0,9">
                            <Border x:Name="SideCpuBar" HorizontalAlignment="Stretch" CornerRadius="2" Background="{StaticResource GoldBrush}" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0.02"/></Border.RenderTransform></Border>
                        </Border>
                        <Grid>
                            <TextBlock Text="RAM" Foreground="{StaticResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SideRamText" Text="0%" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                        <Border Height="4" CornerRadius="2" Background="#1AEFE9E0" Margin="0,5,0,0">
                            <Border x:Name="SideRamBar" HorizontalAlignment="Stretch" CornerRadius="2" Background="#B39C8E" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0.02"/></Border.RenderTransform></Border>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================ CONTENT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Background="Transparent">
                <TextBlock x:Name="TitlePc" Text="" Foreground="{StaticResource FaintBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="28,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnTray" Style="{StaticResource TitleBtn}" AutomationProperties.Name="@{tray.hide.tip}" Content="&#xE70D;" ToolTip="@{tray.hide.tip}" Visibility="Collapsed"/>
                    <Button x:Name="BtnMin" Style="{StaticResource TitleBtn}" AutomationProperties.Name="@{a11y.min}" ToolTip="@{a11y.min}" Content="&#xE921;"/>
                    <Button x:Name="BtnMax" Style="{StaticResource TitleBtn}" AutomationProperties.Name="@{a11y.max}" ToolTip="@{a11y.max}" Content="&#xE922;"/>
                    <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" AutomationProperties.Name="@{a11y.close}" ToolTip="@{a11y.close}" Content="&#xE8BB;"/>
                </StackPanel>
            </Grid>

            <!-- update notice (always on screen when a new version exists) -->
            <Border x:Name="UpdateBanner" Grid.Row="1" Margin="32,0,32,8" CornerRadius="14" Padding="16,10" Visibility="Collapsed" Background="#1AD9BC8C" BorderBrush="#66D9BC8C" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,150,0">
                        <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" Foreground="{StaticResource GoldBrush}" FontSize="14"/>
                        <TextBlock x:Name="UpdateBannerText" Text="" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="BtnBannerUpdate" HorizontalAlignment="Right" Style="{StaticResource BtnPrimary}" Padding="16,7" Content="@{update.now}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" x:Name="Pages">

                <!-- HOME -->
                <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,6,32,36" MaxWidth="1100">
                        <TextBlock x:Name="HomeHello" Style="{StaticResource H1}" Text="@{home.title}"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="@{home.sub2}"/>
                        <Border CornerRadius="20" Background="{StaticResource HeroBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" Padding="26,22" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="@{home.yourpc}" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="HomeStatus" Text="" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="HomeStatusSub" Text="" Style="{StaticResource Sub}" Margin="0,4,0,18"/>
                                    <ItemsControl x:Name="HomeStats" ItemTemplate="{StaticResource StatTpl}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <Button x:Name="BtnOneClick" Style="{StaticResource BtnPrimary}" Padding="24,13">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" Foreground="{StaticResource InkBrush}" FontSize="14"/>
                                            <TextBlock Text="@{home.speedup}" Foreground="{StaticResource InkBrush}" FontSize="14.5" FontWeight="Bold" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                                        <Button x:Name="BtnHomeMeasure" Style="{StaticResource BtnSmall}" Content="@{home.measure}"/>
                                        <Button x:Name="BtnHomeCheck" Style="{StaticResource BtnSmall}" Content="@{home.runcheck}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- notices: Windows undid settings / options removed in 2.0 -->
                        <Border x:Name="LostCard" Style="{StaticResource Note}" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid>
                                <StackPanel Margin="0,0,260,0">
                                    <TextBlock x:Name="LostTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LostText" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnLostIgnore" Style="{StaticResource BtnSmall}" Content="@{lost.ignore}"/>
                                    <Button x:Name="BtnLostFix" Style="{StaticResource BtnPrimary}" Padding="14,7" Content="@{lost.fix}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="RetiredCardHome" Style="{StaticResource Note}" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid>
                                <StackPanel Margin="0,0,200,0">
                                    <TextBlock Text="@{retired.title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="@{retired.home}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnRetiredOpen" Style="{StaticResource BtnSmall}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="@{retired.open}"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="@{home.advice}"/>
                                <ItemsControl x:Name="HomeAdvice" ItemTemplate="{StaticResource FindingTpl}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource H2}" Text="@{home.live}"/>
                                <Border Style="{StaticResource Card}" Padding="18,16">
                                    <StackPanel>
                                        <Canvas x:Name="LiveCanvas" Height="96" ClipToBounds="True">
                                            <Polyline x:Name="LiveCpuLine" Stroke="#D9BC8C" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                                            <Polyline x:Name="LiveRamLine" Stroke="#8C8478" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                                        </Canvas>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Ellipse Width="7" Height="7" Fill="#D9BC8C"/>
                                            <TextBlock Text="CPU" Foreground="{StaticResource MutedBrush}" Margin="6,0,6,0" FontSize="12.5"/>
                                            <TextBlock x:Name="LiveCpuText" Text="0%" FontWeight="SemiBold" FontSize="12.5" Typography.NumeralAlignment="Tabular"/>
                                            <Ellipse Width="7" Height="7" Fill="#8C8478" Margin="16,0,0,0"/>
                                            <TextBlock Text="RAM" Foreground="{StaticResource MutedBrush}" Margin="6,0,6,0" FontSize="12.5"/>
                                            <TextBlock x:Name="LiveRamText" Text="0%" FontWeight="SemiBold" FontSize="12.5" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource H2}" Text="@{home.hardware}"/>
                                <ItemsControl x:Name="HwList" ItemTemplate="{StaticResource HwTpl}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- MEASURE -->
                <ScrollViewer x:Name="PageMeasure" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="32,6,32,36" MaxWidth="1100">
                        <Grid>
                            <StackPanel Margin="0,0,220,0">
                                <TextBlock Style="{StaticResource H1}" Text="@{measure.title}"/>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="@{measure.sub}"/>
                            </StackPanel>
                            <Button x:Name="BtnMeasureRun" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="20,11" Content="@{measure.run}"/>
                        </Grid>
                        <Border Style="{StaticResource Note}" Margin="0,16,0,0">
                            <TextBlock x:Name="MeasureStatus" Style="{StaticResource Sub}" Foreground="{StaticResource Text2Brush}" Text="@{measure.none}"/>
                        </Border>
                        <ItemsControl x:Name="MetricList" ItemTemplate="{StaticResource MetricTpl}" Margin="0,14,-10,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <WrapPanel Margin="0,4,0,0">
                            <Button x:Name="BtnMeasureBaseline" Style="{StaticResource Btn}" Content="@{measure.baseline}" Margin="0,0,8,8"/>
                            <Button x:Name="BtnReportCopy" Style="{StaticResource Btn}" Content="@{report.copy}" Margin="0,0,8,8"/>
                            <Button x:Name="BtnReportSave" Style="{StaticResource Btn}" Content="@{report.save}" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="@{measure.trend}" FontWeight="SemiBold" FontSize="14.5"/>
                                    <TextBlock Text="@{measure.trend.sub}" Style="{StaticResource Sub}" Margin="0,4,0,12"/>
                                    <Canvas x:Name="TrendCanvas" Height="80" ClipToBounds="True">
                                        <Polyline x:Name="TrendLine" Stroke="#D9BC8C" StrokeThickness="2" StrokeLineJoin="Round"/>
                                    </Canvas>
                                    <TextBlock x:Name="TrendText" Style="{StaticResource Sub}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="@{measure.top}" FontWeight="SemiBold" FontSize="14.5"/>
                                    <TextBlock Text="@{measure.top.sub}" Style="{StaticResource Sub}" Margin="0,4,0,12"/>
                                    <ItemsControl x:Name="TopProcList" ItemTemplate="{StaticResource KvTpl}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,14,0,0" Text="@{measure.honest}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- OPTIMIZE (Velocizza) -->
                <ScrollViewer x:Name="PageOptimize" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="32,6,32,36" MaxWidth="1100">
                        <TextBlock Style="{StaticResource H1}" Text="@{opt.title}"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,16" Text="@{opt.sub}"/>
                        <UniformGrid x:Name="PresetPanel" Columns="4" Margin="0,0,-10,0">
                            <RadioButton x:Name="PresetSlowpc" Style="{StaticResource ChoiceCard}" GroupName="preset" Tag="slowpc">
                                <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEC4A;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource GoldBrush}"/><Border x:Name="SlowBadge" CornerRadius="999" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center" Background="{StaticResource GoldBrush}" Visibility="Collapsed"><TextBlock Text="@{preset.foryou}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/></Border></StackPanel><TextBlock Text="@{preset.slowpc}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBlock Text="@{preset.slowpc.d}" Style="{StaticResource Sub}" FontSize="12.5"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetPiki" Style="{StaticResource ChoiceCard}" GroupName="preset" Tag="piki">
                                <StackPanel><TextBlock Text="&#xE734;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Left"/><TextBlock Text="@{preset.piki}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBlock Text="@{preset.piki.d}" Style="{StaticResource Sub}" FontSize="12.5"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetGaming" Style="{StaticResource ChoiceCard}" GroupName="preset" Tag="gaming">
                                <StackPanel><TextBlock Text="&#xE7FC;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Left"/><TextBlock Text="@{preset.gaming}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBlock Text="@{preset.gaming.d}" Style="{StaticResource Sub}" FontSize="12.5"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetCompetitive" Style="{StaticResource ChoiceCard}" GroupName="preset" Tag="competitive">
                                <StackPanel><TextBlock Text="&#xE945;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Left"/><TextBlock Text="@{preset.competitive}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBlock Text="@{preset.competitive.d}" Style="{StaticResource Sub}" FontSize="12.5"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetCreator" Style="{StaticResource ChoiceCard}" GroupName="preset" Tag="creator">
                                <StackPanel><TextBlock Text="&#xE714;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Left"/><TextBlock Text="@{preset.creator}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBlock Text="@{preset.creator.d}" Style="{StaticResource Sub}" FontSize="12.5"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetBalanced" Style="{StaticResource ChoiceCard}" GroupName="preset" Tag="balanced">
                                <StackPanel><TextBlock Text="&#xE80F;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Left"/><TextBlock Text="@{preset.balanced}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBlock Text="@{preset.balanced.d}" Style="{StaticResource Sub}" FontSize="12.5"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetLaptop" Style="{StaticResource ChoiceCard}" GroupName="preset" Tag="laptop">
                                <StackPanel><TextBlock Text="&#xE83F;" Style="{StaticResource IconText}" FontSize="18" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Left"/><TextBlock Text="@{preset.laptop}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBlock Text="@{preset.laptop.d}" Style="{StaticResource Sub}" FontSize="12.5"/></StackPanel>
                            </RadioButton>
                        </UniformGrid>
                        <Border Style="{StaticResource Note}" Margin="0,4,0,0">
                            <Grid>
                                <TextBlock Text="@{opt.legend}" Style="{StaticResource Sub}" Foreground="{StaticResource Text2Brush}" Margin="0,0,230,0" VerticalAlignment="Center"/>
                                <Button x:Name="BtnPreview" Style="{StaticResource BtnSmall}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="@{opt.preview}"/>
                            </Grid>
                        </Border>
                        <Border x:Name="NexusNote" Style="{StaticResource Note}" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="NexusNoteText" Text="@{nexus.detected}" Style="{StaticResource Sub}" Foreground="{StaticResource Text2Brush}"/>
                        </Border>

                        <!-- temporary sessions -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <Grid>
                                <StackPanel Margin="0,0,300,0">
                                    <TextBlock Text="@{session.title}" FontWeight="SemiBold" FontSize="14.5"/>
                                    <TextBlock Text="@{session.sub}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="SessionStatus" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnSessionGame" Style="{StaticResource Btn}" Content="@{session.game}"/>
                                    <Button x:Name="BtnSessionStop" Style="{StaticResource BtnDanger}" Content="@{session.stop}" Margin="8,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="OptList" ItemTemplate="{StaticResource OptionTpl}" Margin="0,6,0,0">
                            <ItemsControl.GroupStyle><GroupStyle HeaderTemplate="{StaticResource GroupHeaderTpl}"/></ItemsControl.GroupStyle>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- PROCESSES (Avvio e app) -->
                <ScrollViewer x:Name="PageProcesses" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="32,6,32,36" MaxWidth="1100">
                        <TextBlock Style="{StaticResource H1}" Text="@{proc.title}"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,16" Text="@{proc.sub}"/>
                        <UniformGrid Columns="4" Margin="0,0,-10,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="16,13"><StackPanel><TextBlock x:Name="StatStartup" Text="-" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="@{proc.stat.startup}" Foreground="{StaticResource MutedBrush}" FontSize="12.5"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="16,13"><StackPanel><TextBlock x:Name="StatHigh" Text="-" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="@{proc.stat.high}" Foreground="{StaticResource MutedBrush}" FontSize="12.5"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="16,13"><StackPanel><TextBlock x:Name="StatProcs" Text="-" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="@{proc.stat.procs}" Foreground="{StaticResource MutedBrush}" FontSize="12.5"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="16,13"><StackPanel><TextBlock x:Name="StatRam" Text="-" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="@{proc.stat.ram}" Foreground="{StaticResource MutedBrush}" FontSize="12.5"/></StackPanel></Border>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                            <RadioButton x:Name="ProcTabStartup" Style="{StaticResource Pill}" GroupName="proctab" IsChecked="True" Content="@{proc.tab.startup}"/>
                            <RadioButton x:Name="ProcTabReduce" Style="{StaticResource Pill}" GroupName="proctab" Content="@{proc.tab.reduce}"/>
                            <RadioButton x:Name="ProcTabRunning" Style="{StaticResource Pill}" GroupName="proctab" Content="@{proc.tab.running}"/>
                        </StackPanel>

                        <StackPanel x:Name="ProcPaneStartup">
                            <TextBlock Text="@{proc.startup.help2}" Style="{StaticResource Sub}" Margin="0,0,0,12"/>
                            <ItemsControl x:Name="StartupList" ItemTemplate="{StaticResource StartupTpl}"/>
                        </StackPanel>

                        <StackPanel x:Name="ProcPaneReduce" Visibility="Collapsed">
                            <TextBlock Text="@{proc.level.q}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <UniformGrid Columns="3" Margin="0,0,-10,0">
                                <RadioButton x:Name="LevelLight" Style="{StaticResource ChoiceCard}" GroupName="level" Tag="1">
                                    <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="#9CC69B"/><TextBlock Text="@{proc.level.1}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"/></StackPanel><TextBlock Text="@{proc.level.1.d}" Style="{StaticResource Sub}" FontSize="12.5" Margin="0,6,0,0"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="LevelBalanced" Style="{StaticResource ChoiceCard}" GroupName="level" Tag="2">
                                    <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="#D9A55C"/><TextBlock Text="@{proc.level.2}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"/></StackPanel><TextBlock Text="@{proc.level.2.d}" Style="{StaticResource Sub}" FontSize="12.5" Margin="0,6,0,0"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="LevelMax" Style="{StaticResource ChoiceCard}" GroupName="level" Tag="3">
                                    <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="#D0606A"/><TextBlock Text="@{proc.level.3}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"/></StackPanel><TextBlock Text="@{proc.level.3.d}" Style="{StaticResource Sub}" FontSize="12.5" Margin="0,6,0,0"/></StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <Border Style="{StaticResource Note}" Margin="0,4,0,14">
