                                <RadioButton x:Name="LevelLight" Style="{StaticResource ChoiceCard}" GroupName="level" Tag="1">
                                    <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#2ED47A"/><TextBlock Text="@{proc.level.1}" FontWeight="Bold" FontSize="14" Margin="8,0,0,0"/></StackPanel><TextBlock Text="@{proc.level.1.d}" Style="{StaticResource Sub}" FontSize="13" Margin="0,6,0,0"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="LevelBalanced" Style="{StaticResource ChoiceCard}" GroupName="level" Tag="2">
                                    <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#FFB547"/><TextBlock Text="@{proc.level.2}" FontWeight="Bold" FontSize="14" Margin="8,0,0,0"/></StackPanel><TextBlock Text="@{proc.level.2.d}" Style="{StaticResource Sub}" FontSize="13" Margin="0,6,0,0"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="LevelMax" Style="{StaticResource ChoiceCard}" GroupName="level" Tag="3">
                                    <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#FF5D73"/><TextBlock Text="@{proc.level.3}" FontWeight="Bold" FontSize="14" Margin="8,0,0,0"/></StackPanel><TextBlock Text="@{proc.level.3.d}" Style="{StaticResource Sub}" FontSize="13" Margin="0,6,0,0"/></StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <ItemsControl x:Name="ProcOptList" ItemTemplate="{StaticResource OptionTpl}">
